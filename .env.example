# --- Nimic din ce urmeaza nu e obligatoriu. Sistemul merge complet fara chei. ---

# Verificarea reala pe Google: are firma fisa (GBP)? are site? cate recenzii?
# Fara ea, mesajul NU mai pretinde ca a cautat pe Google.
# 1.000 apeluri/luna gratis, apoi ~0,002 $ per prospect.
GOOGLE_PLACES_API_KEY=

# firmeapi.ro - doua lucruri diferite:
#   PLAN GRATUIT (1.000 credite/luna, fara card): a doua sursa de firme noi, prin API
#     in loc de scraping, filtrata din start pe CAEN si pe "are telefon".
#   PLAN PLATIT (~200 RON/luna): in plus, administratorul si emailul firmei.
FIRMEAPI_KEY=

# Postgres / Supabase in loc de SQLite local (backup automat + acces din orice browser).
# Lasa gol pentru SQLite.
DATABASE_URL=

# Fisierul SQLite, daca nu folosesti Postgres
MOON_DB_PATH=moon_prospector.db

# Cate zile in urma acceptam o firma ca fiind "noua"
MOON_MAX_AGE_DAYS=7

# Tier-urile acceptate la colectare (A / A,B / A,B,C)
MOON_TIERS=A

# Politete fata de ANAF: pauza intre request-uri (limita oficiala e 1 req/sec)
MOON_ANAF_SLEEP=1.2
